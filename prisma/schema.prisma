generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  EDITOR
  USER
}

enum NutritionUnit {
  G
  ML
}

enum MealType {
  BREAKFAST
  LUNCH
  SNACK
  DINNER
}

enum FoodSourceType {
  OPEN_FOOD_FACTS
  PERSONAL
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SeoEntityType {
  POST
  CATEGORY
  AUTHOR
  PAGE
}

enum NewsletterStatus {
  pending
  active
  unsubscribed
  bounced
  complained
}

enum NewsletterFrequency {
  immediate
  weekly
  monthly
}

enum NewsletterLanguage {
  fr
  en
}

enum NewsletterGoalType {
  hypertrophy
  fat_loss
  strength
  general_fitness
}

model NewsletterSubscriber {
  id                 String                     @id @default(cuid())
  email              String                     @unique
  status             NewsletterStatus           @default(pending)
  language           NewsletterLanguage         @default(en)
  source             String?
  userAgent          String?
  notificationSentAt DateTime?
  consentAt          DateTime?
  consentTextVersion String?
  consentSource      String?
  confirmedAt        DateTime?
  unsubscribedAt     DateTime?
  confirmationToken  String                     @unique
  preferencesToken   String                     @unique
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  preferences        NewsletterPreference?
  goals              NewsletterSubscriberGoal[]

  @@index([status, language])
  @@index([createdAt])
  @@map("newsletter_subscribers")
}

model NewsletterPreference {
  id               String               @id @default(cuid())
  subscriberId     String               @unique
  subscriber       NewsletterSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  newArticles      Boolean              @default(true)
  strengthTraining Boolean              @default(true)
  workoutPrograms  Boolean              @default(true)
  nutrition        Boolean              @default(true)
  supplements      Boolean              @default(true)
  equipment        Boolean              @default(true)
  tools            Boolean              @default(true)
  guides           Boolean              @default(true)
  frequency        NewsletterFrequency  @default(weekly)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([nutrition, frequency])
  @@index([strengthTraining, frequency])
  @@map("newsletter_preferences")
}

model NewsletterSubscriberGoal {
  id           String               @id @default(cuid())
  subscriberId String
  subscriber   NewsletterSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  goal         NewsletterGoalType
  createdAt    DateTime             @default(now())

  @@unique([subscriberId, goal])
  @@index([goal, subscriberId])
  @@map("newsletter_subscriber_goals")
}

model FoodProductCache {
  barcode   String   @id
  product   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  role           UserRole @default(EDITOR)
  displayName    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  nutritionGoals NutritionGoal[]
  personalFoods  PersonalFood[]
  nutritionDays  NutritionDay[]
}

model NutritionGoal {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  caloriesKcal    Decimal  @db.Decimal(18, 6)
  proteinG        Decimal  @db.Decimal(18, 6)
  carbohydratesG Decimal  @db.Decimal(18, 6)
  fatG            Decimal  @db.Decimal(18, 6)
  effectiveFrom   DateTime @db.Date
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, effectiveFrom])
  @@index([userId, effectiveFrom])
}

model PersonalFood {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  brand           String?
  basisAmount     Decimal         @db.Decimal(18, 6)
  basisUnit       NutritionUnit
  caloriesKcal    Decimal         @db.Decimal(18, 6)
  proteinG        Decimal         @db.Decimal(18, 6)
  carbohydratesG Decimal         @db.Decimal(18, 6)
  fatG            Decimal         @db.Decimal(18, 6)
  entries         FoodEntry[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId, createdAt])
}

model NutritionDay {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime    @db.Date
  entries   FoodEntry[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

model FoodEntry {
  id                      String         @id @default(cuid())
  nutritionDayId          String
  nutritionDay            NutritionDay   @relation(fields: [nutritionDayId], references: [id], onDelete: Cascade)
  mealType                MealType
  sourceType              FoodSourceType
  productBarcode          String?
  personalFoodId          String?
  personalFood            PersonalFood?  @relation(fields: [personalFoodId], references: [id], onDelete: SetNull)
  consumedAmount          Decimal        @db.Decimal(18, 6)
  consumedUnit            NutritionUnit
  snapshotName            String
  snapshotBrand           String?
  snapshotBasisAmount     Decimal        @db.Decimal(18, 6)
  snapshotBasisUnit       NutritionUnit
  snapshotCaloriesKcal    Decimal        @db.Decimal(18, 6)
  snapshotProteinG        Decimal        @db.Decimal(18, 6)
  snapshotCarbohydratesG  Decimal        @db.Decimal(18, 6)
  snapshotFatG            Decimal        @db.Decimal(18, 6)
  computedCaloriesKcal    Decimal        @db.Decimal(18, 6)
  computedProteinG        Decimal        @db.Decimal(18, 6)
  computedCarbohydratesG Decimal        @db.Decimal(18, 6)
  computedFatG            Decimal        @db.Decimal(18, 6)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  @@index([nutritionDayId, mealType])
  @@index([personalFoodId])
  @@index([productBarcode])
}

model Author {
  id             String      @id @default(cuid())
  name           String
  slug           String      @unique
  bio            String?
  avatarMediaId  String?
  avatarMedia    Media?      @relation(fields: [avatarMediaId], references: [id])
  posts          Post[]
  seoMetadata    SeoMetadata?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model Category {
  id             String      @id @default(cuid())
  name           String
  slug           String      @unique
  description    String?
  posts          Post[]
  seoMetadata    SeoMetadata?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model Tag {
  id             String      @id @default(cuid())
  name           String
  slug           String      @unique
  postTags       PostTag[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model Media {
  id             String      @id @default(cuid())
  url            String
  altText        String?
  caption        String?
  mimeType       String?
  source         String      @default("external")
  storageKey     String?     @unique
  bucket         String?
  sizeBytes      Int?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  posts          Post[]      @relation("CoverMedia")
  authorAvatars  Author[]
  seoOpenGraphFor SeoMetadata[] @relation("SeoOpenGraphImage")
}

model Post {
  id                 String       @id @default(cuid())
  title              String
  slug               String
  locale             String       @default("en")
  translationGroupId String       @default(dbgenerated("gen_random_uuid()::text"))
  h1                 String?
  chapoHtml          String?
  excerpt            String?
  contentMarkdown    String
  contentJson        Json?
  contentHtml        String?
  faqJson            Json?
  heroImageUrl       String?
  heroImageAlt       String?
  metaTitle          String?
  metaDescription    String?
  canonicalUrl       String?
  robots             String       @default("noindex,follow")
  isActive           Boolean      @default(false)
  isIndexable        Boolean      @default(false)
  categorySlug       String?
  tagsJson           Json?
  jsonLd             Json?
  status             PostStatus   @default(DRAFT)
  publishedAt        DateTime?
  readingTimeMinutes Int?
  authorId           String
  author             Author       @relation(fields: [authorId], references: [id])
  categoryId         String?
  category           Category?    @relation(fields: [categoryId], references: [id])
  coverImageId       String?
  coverImage         Media?       @relation("CoverMedia", fields: [coverImageId], references: [id])
  seoMetadata        SeoMetadata?
  postTags           PostTag[]
  relatedFrom        PostRelation[] @relation("SourcePost")
  relatedTo          PostRelation[] @relation("TargetPost")
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([locale, slug])
  @@unique([translationGroupId, locale])
  @@index([translationGroupId])
  @@index([locale, status, publishedAt])
  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([authorId])
}

model PostTag {
  postId    String
  tagId     String
  post      Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag       Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model PostRelation {
  sourcePostId String
  targetPostId String
  sourcePost   Post @relation("SourcePost", fields: [sourcePostId], references: [id], onDelete: Cascade)
  targetPost   Post @relation("TargetPost", fields: [targetPostId], references: [id], onDelete: Cascade)

  @@id([sourcePostId, targetPostId])
}

model SeoMetadata {
  id               String         @id @default(cuid())
  entityType       SeoEntityType
  title            String?
  description      String?
  canonicalUrl     String?
  noIndex          Boolean        @default(false)
  openGraphImageId String?
  openGraphImage   Media?         @relation("SeoOpenGraphImage", fields: [openGraphImageId], references: [id])
  postId           String?        @unique
  post             Post?          @relation(fields: [postId], references: [id], onDelete: Cascade)
  categoryId       String?        @unique
  category         Category?      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  authorId         String?        @unique
  author           Author?        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  pageKey          String?        @unique
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([entityType])
}
