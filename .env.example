DATABASE_URL="postgresql://postgres:postgres@localhost:5432/muscle_temple?schema=public"
PORT=4000
NODE_ENV=development
APP_URL="http://localhost:4000"
ADMIN_EMAIL="admin@muscletemple.com"
ADMIN_PASSWORD="ChangeMeStrongPassword123!"
JWT_SECRET="change-this-to-a-long-random-string-at-least-32-chars"
CORS_ORIGIN="http://localhost:3000,https://your-nextjs-domain.vercel.app"

# AWS S3 / CloudFront image uploads
# The S3 bucket should stay private; public image URLs are built with AWS_CLOUDFRONT_URL.
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_REGION="eu-west-3"
AWS_S3_BUCKET_NAME="the-muscle-temple-media"
AWS_CLOUDFRONT_URL="https://cdn.example.com"
AWS_S3_UPLOAD_MAX_BYTES=5242880

CMS_PORT=4001
PAYLOAD_SECRET="change-this-payload-secret"

# SMTP newsletter notifications (Brevo or compatible SMTP server)
SMTP_SERVER="smtp-relay.brevo.com"
SMTP_PORT=587
SMTP_USERNAME="your-smtp-login"
SMTP_PASSWORD="your-smtp-password"
SMTP_EHLO_DOMAIN="the-muscle-temple-api"
MAIL_FROM="admin@example.com"
NEWSLETTER_RECIPIENT_EMAIL="contact@2dolist.fr"
